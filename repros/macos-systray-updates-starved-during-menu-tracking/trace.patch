+// Trace hooks used by repros/macos-systray-updates-starved-during-menu-tracking
+// to show which code path enters native menu tracking.
+static void systrayTrace(const char *what) {
+	struct timeval tv;
+	gettimeofday(&tv, NULL);
+	struct tm lt;
+	localtime_r(&tv.tv_sec, &lt);
+	fprintf(stderr, "%02d:%02d:%02d.%03d          trace %s\n",
+	        lt.tm_hour, lt.tm_min, lt.tm_sec, (int)(tv.tv_usec / 1000), what);
+	fflush(stderr);
+}
+
